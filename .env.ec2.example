NODE_ENV=production
PORT=3000

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

# MySQL running locally on the same EC2 instance
DATABASE_URL=mysql://divinegrow_app:REPLACE_WITH_PASSWORD@127.0.0.1:3306/divinegrow

# Frontend assets served by Nginx from the attached EBS volume
VITE_ASSET_BASE_URL=/assets/spices

# AWS SES email notifications
AWS_REGION=ap-south-1
SES_FROM_EMAIL=verified-sender@yourdomain.com
SES_TO_EMAIL=cemde.pankaj@gmail.com

# Only keep these if you intentionally retain Manus OAuth/notification infrastructure.
# VITE_APP_ID=
# OAUTH_SERVER_URL=
# OWNER_OPEN_ID=
# BUILT_IN_FORGE_API_URL=
# BUILT_IN_FORGE_API_KEY=
